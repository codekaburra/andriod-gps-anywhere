# Release signing config — copy this file to `keystore.properties` and fill in
# your own values. `keystore.properties` and the keystore itself are git-ignored.
#
# 1. Generate an upload keystore (you choose the passwords):
#      keytool -genkeypair -v -keystore upload-keystore.jks \
#        -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# 2. Copy this file:  cp keystore.properties.template keystore.properties
# 3. Fill in the four values below.
#
# storeFile path is resolved relative to the app module (app/).
storeFile=../upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
